# Copy this file to .env and fill in what you want. Everything is optional.

# --- Free LLM for the smart parts (planner / page targeting / reports) ---
# If OLLAMA_API_KEY is set, web-gather uses the Ollama Cloud API.
# If not set, it uses a local Ollama server (get it free at ollama.com).
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:20b-cloud
# local alternative:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# --- Optional: restrict CORS to specific website(s); comma separated.
# Leave empty for open access (any website may call the API).
# CORS_ORIGINS=https://mysite.com,https://sub.mysite.com